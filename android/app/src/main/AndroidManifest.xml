<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TickTick's API, and GitHub's releases API for Check for updates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The optional floating bubble: an overlay kept alive by a foreground service -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Tickfind"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Settings">

        <!-- The search box. The launcher icon, the bubble, the tile and the assistant gesture all open this. -->
        <activity android:name=".SearchActivity" android:exported="true" android:theme="@style/Floating"
            android:launchMode="singleTask" android:taskAffinity="io.github.bosthecoder.tickfind.search"
            android:excludeFromRecents="true" android:windowSoftInputMode="stateAlwaysVisible|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets Android offer Tickfind as the "digital assistant app", so the assistant gesture opens it -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings, sign-in and updates. Also where TickTick's sign-in comes back to. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:label="Tickfind settings">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.bosthecoder.tickfind" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service android:name=".BubbleService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating button over other apps that opens task search" />
        </service>

        <service android:name=".SearchTile" android:exported="true" android:label="Search TickTick"
            android:icon="@drawable/ic_search" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Not exported: BOOT_COMPLETED and MY_PACKAGE_REPLACED come from the system, which still reaches it. -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
